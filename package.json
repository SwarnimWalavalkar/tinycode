{
  "name": "tinycode",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "A small, portable web workspace for Codex, Claude Code, and Pi.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare.mjs",
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "check": "tsc -b && vitest run",
    "test:smoke": "node scripts/http-smoke.mjs && node scripts/image-http-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^0.544.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "node-pty"
  ]
}
