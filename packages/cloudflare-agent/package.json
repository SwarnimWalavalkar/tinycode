{
  "name": "@tinycode/cloudflare-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "check": "npm run typecheck && npm run test",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.4",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.127.1"
  }
}
