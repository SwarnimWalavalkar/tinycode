# Copy to .dev.vars in this directory. Never commit real credentials.
# Local-only login token; never use this example for a deployed server.
TINYCODE_AGENT_TOKEN="tinycode-local-smoke-token-not-a-secret"
CLOUDFLARE_ACCOUNT_ID="00000000000000000000000000000000"
CLOUDFLARE_GATEWAY_ID="default"
# Leave blank for credential-free HTTP tests. For live inference, use an
# account-scoped API token with Account > Workers AI > Read permission.
CLOUDFLARE_API_TOKEN=""
# Restrict local conversations AND title suggestions to Workers AI.
TINYCODE_DEFAULT_MODEL="@cf/zai-org/glm-5.3-flash"
TINYCODE_MODELS="@cf/zai-org/glm-5.3-flash,@cf/deepseek-ai/deepseek-v4-flash-0731"

# Optional GitHub account mode: configure ALL THREE with a separate development
# OAuth App whose callback is http://localhost:8794/api/auth/github/callback.
# Leave absent for the token-mode smoke test. Never commit real values.
# GITHUB_OAUTH_CLIENT_ID=""
# GITHUB_OAUTH_CLIENT_SECRET=""
# TINYCODE_AUTH_SECRET="" # Random, stable encryption secret; at least 32 characters.
