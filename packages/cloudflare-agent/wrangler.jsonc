{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tinycode-cloudflare-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/socket"]
  },
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "tinycode-attachments" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "durable_objects": {
    "bindings": [
      { "name": "AGENTS", "class_name": "DurablePiAgent" },
      { "name": "SANDBOX", "class_name": "Sandbox" },
      { "name": "DIRECTORY", "class_name": "TaskDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DurablePiAgent", "Sandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["TaskDirectory"] }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 5
    }
  ],
  "vars": {
    "TINYCODE_DEFAULT_MODEL": "openai/gpt-5.4",
    "TINYCODE_MODELS": "openai/gpt-5.4,openai/gpt-5.4-mini"
  }
}
